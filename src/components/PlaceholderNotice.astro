---
interface Props {
  title?: string;
}

const { title = 'Content awaiting QA input' } = Astro.props;
---

<aside class="placeholder-notice">
  <span class="placeholder-label">Placeholder</span>
  <div>
    <strong>{title}</strong>
    <div class="placeholder-copy"><slot /></div>
  </div>
</aside>

<style>
  .placeholder-notice {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-left: 4px solid var(--warning);
    border-radius: var(--radius);
    background: var(--card);
  }

  .placeholder-label {
    padding: 0.18rem 0.42rem;
    color: var(--warning-ink);
    background: var(--warning-surface);
    border-radius: var(--radius);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  strong {
    display: block;
    color: var(--foreground);
  }

  .placeholder-copy :global(p) {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
  }

  @media (max-width: 30rem) {
    .placeholder-notice {
      grid-template-columns: 1fr;
    }
  }
</style>
