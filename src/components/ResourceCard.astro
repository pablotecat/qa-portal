---
interface Props {
  type: 'Snippet' | 'Tool' | 'Repository';
  title: string;
  purpose: string;
  owner?: string;
  technologies?: string[];
  status?: string;
  lastReviewed?: string;
  warning?: string;
  href?: string;
}

const {
  type,
  title,
  purpose,
  owner = 'TODO: Add owner',
  technologies = [],
  status = 'TODO: Define status',
  lastReviewed = 'TODO: Add date',
  warning,
  href,
} = Astro.props;
---

<article class="resource-card">
  <div class="resource-topline">
    <span>{type}</span>
    <span>{status}</span>
  </div>
  <h3>{title}</h3>
  <p class="purpose">{purpose}</p>
  <dl>
    <div><dt>Owner</dt><dd>{owner}</dd></div>
    <div><dt>Last reviewed</dt><dd>{lastReviewed}</dd></div>
  </dl>
  {technologies.length > 0 && (
    <ul aria-label="Technologies">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  )}
  {warning && <p class="warning"><strong>Usage note:</strong> {warning}</p>}
  {href && <a href={href}>Open resource <span aria-hidden="true">→</span></a>}
</article>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 3px solid var(--sl-color-accent);
    background: var(--sl-color-bg-nav);
  }

  .resource-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 1rem 0 0;
    color: var(--sl-color-white);
    font-size: 1.05rem;
  }

  .purpose {
    flex: 1;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  dt {
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  dd {
    margin: 0.2rem 0 0;
    color: var(--sl-color-gray-1);
    font-size: 0.78rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.12rem 0.4rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
  }

  .warning {
    margin: 0.9rem 0 0;
    color: var(--sl-color-orange-high);
    font-size: 0.78rem;
  }

  a {
    margin-top: 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }
</style>
